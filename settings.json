{
  "project": {
    "name": "마파고",
    "description": "일본식 4인 리치 마작 AI 대국 및 코치 시스템",
    "language": "ko-KR",
    "notionProject": "마파고"
  },
  "product": {
    "players": 4,
    "humanPlayers": 1,
    "aiPlayers": 3,
    "initialApproach": "rule-based",
    "reinforcementLearningRequiredForMvp": false
  },
  "scope": {
    "mvp": [
      "4인 1인 대 AI 대국",
      "엔진 기반 합법 행동 처리",
      "규칙 기반 AI와 난이도 프로필",
      "샹텐·유효패·추천 타패 및 근거",
      "대국 저장과 주요 판단 복기"
    ],
    "deferred": [
      "강화학습 정책 및 대규모 자기 대국",
      "멀티플레이",
      "클라우드 분석",
      "모바일 지원"
    ]
  },
  "technology": {
    "status": "human-ui-implemented-browser-qa-pending",
    "stage3": {
      "entrypoint": "python -m mapago_tools.server",
      "frontend": "HTML/CSS/JavaScript",
      "backend": "Python-standard-library-loopback-HTTP",
      "bind": "127.0.0.1",
      "defaultPort": 8765,
      "gameMode": "kyoku",
      "humanSeat": 0,
      "storage": "in-memory-browser-session",
      "report": "docs/stage-3-human-ui.md",
      "apiVerified": true,
      "browserVerified": false,
      "scope": "local-prototype"
    },
    "stage2": {
      "entrypoint": "python -m mapago_tools.match",
      "modes": ["kyoku", "east", "hanchan"],
      "botPolicies": ["first-legal-v1", "random-legal-v1", "rule-based-v1"],
      "storage": "local-json-prototype",
      "internalSchema": "mapago.match.v1",
      "seatReplaySchema": "mapago.seat-replay.v1",
      "replay": "saved-legal-actions-with-state-and-event-checks",
      "report": "docs/stage-2-auto-match.md",
      "operationalStorageAndRetentionUndecided": true
    },
    "stage1": {
      "engine": "RiichiEnv",
      "version": "0.4.11",
      "python": "3.12",
      "gameMode": "YON_IKKYOKU",
      "rulePreset": "tenhou",
      "scope": "local-engine-probe",
      "researchHelper": "mahjong==2.1.0",
      "report": "docs/stage-1-engine-review.md",
      "productRulesFinalized": false,
      "frontendBackendStorageUndecided": true
    },
    "candidates": {
      "frontend": ["React"],
      "backend": ["Python", "FastAPI"],
      "rating": ["OpenSkill"]
    },
    "requireOfficialDocsAndLicenseReview": true
  },
  "development": {
    "defaultLanguage": "ko-KR",
    "requireLegalActionsFromEngine": true,
    "keepAiLogicSeparateFromUi": true,
    "protectHiddenInformation": true,
    "reportUntestedChangesAsUntested": true
  }
}
